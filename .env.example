# Copy thành .env và điền. KHÔNG commit .env.
# --- Server lab RTX 4090 ---
SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519
SERVER_WORKDIR=~/v2d
# --- Hugging Face (dataset public, token chỉ cần cho model gated như SAM3D/CARI4D) ---
HF_TOKEN=
# --- Kaggle (chỉ cần nếu nộp late submission) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
# token kiểu mới (KGAT_...), dùng với Kaggle CLI ≥ 2.x và header "Authorization: Bearer"; có cái này thì không cần KAGGLE_KEY
KAGGLE_API_TOKEN=
# --- NGC (Isaac Lab docker, user tự docker login nvcr.io trên server) ---
NGC_API_KEY=
